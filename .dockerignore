**/.pytest_cache
**/.ruff_cache
**/.venv
**/venv
**/node_modules
**/.next
**/dist
**/build
**/*.pyc
**/*.pyo
**/*.log
*.egg-info
coverage
tmp
.env
.env.*
!.env.*.template
