# Keep the shared base and service build contexts small. The Compose Dockerfiles
# copy only the computor-* trees and their startup/config files below.
.git
.github
.claude
**/.git
**/__pycache__
**/.mypy_cache
**/.pytest_cache
**/.ruff_cache
**/.venv
**/venv
**/node_modules
**/.next
**/dist
**/build
**/*.pyc
**/*.pyo
**/*.log
*.egg-info
coverage
tmp
.env
.env.*
!.env.*.template
# Operator runtime data next to the bootstrap examples (backups, generated
# deployment files). No image copies it, and an entry the build user cannot
# read fails the whole build — including an update's rollback.
data/deployments
