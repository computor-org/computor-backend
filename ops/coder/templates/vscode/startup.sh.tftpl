set -e

# Dev mode: forward localhost ports to host machine via socat
%{ if dev_forward_ports != "" }
for port in $(echo "${dev_forward_ports}" | tr ',' ' '); do
  echo "Forwarding localhost:$port -> host.docker.internal:$port"
  socat TCP-LISTEN:$port,fork,reuseaddr TCP:host.docker.internal:$port &
done
%{ endif }

# Initialize home directory from skeleton if first run
if [ ! -f ~/.init_done ]; then
  cp -rT /etc/skel ~
  touch ~/.init_done
fi

# Configure git with user info
git config --global user.name "${full_name}"
git config --global user.email "${email}"

# Create default workspace folder
mkdir -p ~/workspace

# Where matplotlib publishes figures and the Computor extension reads them
# from (issue #279). Created up front so both sides find it owned by coder.
mkdir -p "$${COMPUTOR_FIGURES_DIR:-/tmp/computor-figures}"

# Notebooks keep their inline plots. MPLBACKEND sends a terminal run to the
# figure folder, but a notebook cell should still render its plot under the
# cell. IPKernelApp.matplotlib is scoped to that one application, so it
# redirects Jupyter kernels only — plain python and terminal IPython stay on
# the figure folder. This cannot live in the image: IPython reads config from
# the profile directory and nowhere else (there is no /etc/ipython). Written
# only when absent, so a student who edits it keeps their version.
IPYTHON_PROFILE="$HOME/.ipython/profile_default"
mkdir -p "$IPYTHON_PROFILE"
if [ ! -f "$IPYTHON_PROFILE/ipython_config.py" ]; then
  cat > "$IPYTHON_PROFILE/ipython_config.py" <<'IPYTHON_EOF'
# Computor: render notebook plots under the cell rather than publishing them
# to the figure folder. See docs/figures.md.
c.IPKernelApp.matplotlib = "inline"
IPYTHON_EOF
fi

# Create Computor extension config directory and file
mkdir -p ~/.computor
cat > ~/.computor/config.json << COMPUTOR_EOF
{
  "version": "1.0.0",
  "authentication": {
    "baseUrl": "${computor_backend_url}",
    "autoLogin": true
  }
}
COMPUTOR_EOF

# Create workspace marker file (triggers extension activation)
touch ~/workspace/.computor

# User personalization hook: with the shared per-user home, apt-installed
# software is per-workspace and lost on rebuild — users can re-apply such
# setup in an executable ~/personalize script.
if [ -x "$HOME/personalize" ]; then
  "$HOME/personalize" >/tmp/personalize.log 2>&1 || true
fi

# Images open in the Computor viewer because the built-in one cannot show them
# here. It fetches the picture, its stylesheet and its script from a host that
# exists only inside the webview service worker, and under code-server the
# webview content sits in a grandchild iframe whose requests Firefox never
# routes through that worker (older Safari fails the same way for its own
# reason). What a student saw instead was VS Code's own hidden panels —
# "An error occurred while loading the image" next to "The image is stored with
# Git LFS" — neither of them true (computor-org/issues#282). The Computor
# viewer inlines the image as a data: URI, so there is no fetch to lose. It is
# contributed at "option" priority precisely so this association, and not the
# extension, decides where it takes over: a lecturer running the extension on
# their own machine keeps the built-in editor, which works fine there.
USER_DATA_DIR="/home/coder/.local/share/code-server-${workspace_name_lower}"
SETTINGS_FILE="$USER_DATA_DIR/User/settings.json"
mkdir -p "$USER_DATA_DIR/User"
if [ ! -f "$SETTINGS_FILE" ]; then
  cat > "$SETTINGS_FILE" <<'SETTINGS_EOF'
{
  "workbench.editorAssociations": {
    "*.png": "computor.imagePreview",
    "*.jpg": "computor.imagePreview",
    "*.jpeg": "computor.imagePreview",
    "*.gif": "computor.imagePreview",
    "*.bmp": "computor.imagePreview",
    "*.webp": "computor.imagePreview",
    "*.svg": "computor.imagePreview"
  },
    "workbench.editor.closeEmptyGroups": false,
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": false,
    "extensions.ignoreRecommendations": true,
    "extensions.showRecommendationsOnlyOnDemand": true,
    "security.workspace.trust.enabled": false,
    "security.workspace.trust.startupPrompt": "never",
    "security.workspace.trust.banner": "never",
    "security.workspace.trust.untrustedFiles": "open",
    "update.mode": "none",
    "update.showReleaseNotes": false,
    "workbench.startupEditor": "none",
    "workbench.welcomePage.walkthroughs.openOnInstall": false
}
SETTINGS_EOF
else
  # Workspaces built before a setting was added already have this file, and it
  # is written once and then owned by the student — so add what is missing and
  # touch nothing else. A file with comments in it (VS Code allows them) is not
  # parseable here; leaving it alone is the right answer either way.
  python3 - "$SETTINGS_FILE" <<'MERGE_EOF' || echo "WARN: could not update $SETTINGS_FILE; its settings stay as they are" >&2
import json
import os
import sys
import tempfile

path = sys.argv[1]
wanted = {
    "workbench.editorAssociations": {
        "*.png": "computor.imagePreview",
        "*.jpg": "computor.imagePreview",
        "*.jpeg": "computor.imagePreview",
        "*.gif": "computor.imagePreview",
        "*.bmp": "computor.imagePreview",
        "*.webp": "computor.imagePreview",
        "*.svg": "computor.imagePreview",
    },
    # Keep the empty aux group alive: closing the last file in a group must
    # not collapse the two-column layout (computor-org/issues#286).
    "workbench.editor.closeEmptyGroups": False,
    # Extensions live in the image, not on the home volume, so an update a
    # student installs is gone after the next restart and is then offered
    # again — forever (computor-org/issues#330). Newer extensions ship by
    # bumping the pins in the Dockerfile.
    "extensions.autoCheckUpdates": False,
    "extensions.autoUpdate": False,
    "extensions.ignoreRecommendations": True,
    "extensions.showRecommendationsOnlyOnDemand": True,
    # These are managed course workspaces. Trust prompts only put the editor in
    # Restricted Mode and disable the teaching extension students came to use.
    "security.workspace.trust.enabled": False,
    "security.workspace.trust.startupPrompt": "never",
    "security.workspace.trust.banner": "never",
    "security.workspace.trust.untrustedFiles": "open",
    # Releases carry a tested code-server + extension set. Upstream prompts are
    # noise here and inviting an in-place update makes the image irreproducible.
    "update.mode": "none",
    "update.showReleaseNotes": False,
    "workbench.startupEditor": "none",
    "workbench.welcomePage.walkthroughs.openOnInstall": False,
}

try:
    with open(path, encoding="utf-8") as handle:
        settings = json.load(handle)
except ValueError as error:
    # VS Code accepts comments and trailing commas in settings.json; json does
    # not. A file this cannot read is a file it has no business rewriting.
    raise SystemExit("settings.json is not plain JSON (%s)" % error)
if not isinstance(settings, dict):
    raise SystemExit("settings.json does not hold an object")

missing = {key: value for key, value in wanted.items() if key not in settings}
if not missing:
    raise SystemExit(0)

settings.update(missing)
with tempfile.NamedTemporaryFile(
    "w", encoding="utf-8", dir=os.path.dirname(path), delete=False
) as out:
    json.dump(settings, out, indent=2)
    out.write("\n")
    temporary = out.name
os.replace(temporary, path)
print("settings.json: added " + ", ".join(sorted(missing)))
MERGE_EOF
fi

# Start code-server in background
# Configure abs-proxy-base-path for Traefik routing at /coder prefix
# Bind to 0.0.0.0 so Traefik can reach it from outside the container
# Use password auth if password is provided, otherwise no auth
# The home is shared across the user's workspaces, so code-server state
# (open editors, machine settings) is scoped per workspace via user-data-dir
%{ if app_hash != "" }
# code-server compares its session cookie against HASHED_PASSWORD, so handing it
# the argon2 hash lets the ingress inject a ready-made session — the user never
# sees a login page, while a request that did not come through the ingress
# (another workspace dialling this container directly) has no cookie and is
# bounced to the login page.
# SINGLE quotes: an argon2 hash is $argon2id$v=19$m=...$salt$digest, and in
# double quotes the shell expands every $-segment as an undefined variable —
# code-server then sees a mangled value, never matches the injected cookie, and
# shows its login page.
export HASHED_PASSWORD='${app_hash}'
code-server \
  --auth password \
  --disable-update-check \
  --disable-workspace-trust \
  --bind-addr 0.0.0.0:${code_server_port} \
  --abs-proxy-base-path "${coder_base_path}/${owner_name}/${workspace_name}" \
  --extensions-dir /opt/code-server/extensions \
  --user-data-dir "$USER_DATA_DIR" \
  /home/coder/workspace \
  >/tmp/code-server.log 2>&1 &
%{ else }
echo "WARNING: no workspace app secret was issued — the editor is reachable" \
     "by any other workspace on this network." >&2
code-server \
  --auth none \
  --disable-update-check \
  --disable-workspace-trust \
  --bind-addr 0.0.0.0:${code_server_port} \
  --abs-proxy-base-path "${coder_base_path}/${owner_name}/${workspace_name}" \
  --extensions-dir /opt/code-server/extensions \
  --user-data-dir "$USER_DATA_DIR" \
  /home/coder/workspace \
  >/tmp/code-server.log 2>&1 &
%{ endif }

# Block until code-server actually accepts connections. The agent only reports
# lifecycle_state=ready once this script exits, and the web launch page sends the
# user to the workspace on that signal — without this gate the script would exit
# the instant code-server was *launched* and the user would land on a 502.
# Any HTTP answer proves it is listening, hence no curl -f (code-server 302s to
# its login page under password auth). Capped well under the agent's 300s
# startup_script_timeout; falling through without a connection is not fatal.
for _ in $(seq 1 120); do
  curl -s -o /dev/null --max-time 1 "http://127.0.0.1:${code_server_port}/" && break
  sleep 1
done
