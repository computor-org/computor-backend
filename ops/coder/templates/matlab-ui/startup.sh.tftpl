set -e

%{ if dev_forward_ports != "" }
for port in $(echo "${dev_forward_ports}" | tr ',' ' '); do
  echo "Forwarding localhost:$port -> host.docker.internal:$port"
  socat TCP-LISTEN:$port,fork,reuseaddr TCP:host.docker.internal:$port &
done
%{ endif }

# Shared per-user home volume can retain foreign-owned state from other
# workspace types or older image builds — heal ownership on every start, not
# just first run.
sudo chown -R coder:coder "$HOME" 2>/dev/null || true

# The MATLAB release this image carries; see the Dockerfile's FROM.
MATLAB_RELEASE=R2025b

# Seed the home volume from MathWorks' original home. Best-effort: it must
# never block matlab-proxy from starting; --update=none only fills missing
# files, so re-runs are safe.
#
# The marker is per template, so matlab-vscode's seed doesn't suppress this
# one, and per release. That second part is load-bearing here: matlab-proxy-app
# is on PATH at /home/matlab/.local/bin, /home/matlab is a symlink to this
# shared home, and the binary therefore comes from the *seed* rather than from
# the image. A workspace that already ran on R2024b would otherwise keep
# running R2024b's matlab-proxy against an R2025b MATLAB forever.
SEED_MARKER="$HOME/.matlab_ui_init_done.$MATLAB_RELEASE"
if [ ! -f "$SEED_MARKER" ]; then
  cp -a --update=none /opt/matlab-home-seed/. "$HOME"/ \
    || echo "WARN: matlab home seed incomplete; continuing" >&2
  # --update=none is what keeps a student's own files safe, but it would also
  # keep the previous release's tooling. Nothing under .local is the student's.
  if [ -d /opt/matlab-home-seed/.local ]; then
    cp -a /opt/matlab-home-seed/.local/. "$HOME/.local"/ \
      || echo "WARN: matlab-proxy refresh incomplete; continuing" >&2
  fi
  rm -f "$HOME/.matlab_ui_init_done"
  touch "$SEED_MARKER"
fi

git config --global user.name "${full_name}"
git config --global user.email "${email}"
mkdir -p "$HOME/workspace"

if [ -x "$HOME/personalize" ]; then
  "$HOME/personalize" >/tmp/personalize.log 2>&1 || true
fi

# MATLAB Proxy owns the complete Coder prefix. Traefik must not strip it.
export MWI_BASE_URL="${coder_base_path}/${owner_name}/${workspace_name}"
export MWI_APP_PORT="${matlab_proxy_port}"
export MWI_APP_HOST="0.0.0.0"
# Token auth so the MATLAB desktop is not driveable by another workspace
# dialling this container directly on the shared bridge; the ingress injects the
# token as an mwi-auth-token header for browser traffic. An empty secret leaves
# it open, as before.
%{ if app_secret != "" }
export MWI_ENABLE_TOKEN_AUTH="True"
export MWI_AUTH_TOKEN='${app_secret}'
%{ else }
echo "WARNING: no workspace app secret was issued — MATLAB is reachable by any" \
     "other workspace on this network." >&2
export MWI_ENABLE_TOKEN_AUTH="False"
%{ endif }
export MWI_LOG_FILE="/tmp/matlab-proxy.log"

matlab-proxy-app >/tmp/matlab-proxy-stdout.log 2>&1 &

# Block until matlab-proxy actually accepts connections. The agent only reports
# lifecycle_state=ready once this script exits, and the web launch page sends the
# user to the workspace on that signal — without this gate the script would exit
# the instant matlab-proxy was *launched* and the user would land on a 502 (the
# failure this workspace type has already been bitten by).
# Any HTTP answer proves it is listening, hence no curl -f (matlab-proxy serves
# under MWI_BASE_URL, so / returns 404). Capped well under the agent's 300s
# startup_script_timeout; falling through is not fatal.
for _ in $(seq 1 120); do
  curl -s -o /dev/null --max-time 1 "http://127.0.0.1:${matlab_proxy_port}/" && break
  sleep 1
done
