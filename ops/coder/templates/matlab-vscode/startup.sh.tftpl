set -e

%{ if dev_forward_ports != "" }
for port in $(echo "${dev_forward_ports}" | tr ',' ' '); do
  echo "Forwarding localhost:$port -> host.docker.internal:$port"
  socat TCP-LISTEN:$port,fork,reuseaddr TCP:host.docker.internal:$port &
done
%{ endif }

# Shared per-user home volume can retain foreign-owned state from other
# workspace types or older image builds — heal ownership on every start, not
# just first run.
sudo chown -R coder:coder "$HOME" 2>/dev/null || true

# Restore only missing files from MathWorks' original home. matlab-proxy's
# generated scripts retain /home/matlab paths, which resolve through the image's
# compatibility symlink to this shared home. Seed once per template (marker is
# template-specific so matlab-ui's seed doesn't suppress this one) and
# best-effort: it must never block code-server from starting.
if [ ! -f "$HOME/.matlab_vscode_init_done" ]; then
  cp -a --update=none /opt/matlab-home-seed/. "$HOME"/ \
    || echo "WARN: matlab home seed incomplete; continuing" >&2
  touch "$HOME/.matlab_vscode_init_done"
fi

git config --global user.name "${full_name}"
git config --global user.email "${email}"
mkdir -p "$HOME/workspace"

# The folder MATLAB publishes its figures into, and the Computor extension
# watches. No DISPLAY is set up for it and none is wanted: MATLAB exports
# figures from a session with no display at all, and the virtual display this
# script used to attach was what took the workspace down — every MATLAB in the
# container, including the background one the MathWorks extension runs,
# inherited a display that did not answer and blocked on it.
#
# Publishing is on unless COMPUTOR_FIGUREWATCH=0 is set on the agent, which
# turns off the MATLAB side and nothing else. See docs/figures.md.
mkdir -p "$${COMPUTOR_FIGURES_DIR:-/tmp/computor-figures}"

# Configure and activate the Computor extension for this workspace.
mkdir -p "$HOME/.computor"
cat > "$HOME/.computor/config.json" <<COMPUTOR_EOF
{
  "version": "1.0.0",
  "authentication": {
    "baseUrl": "${computor_backend_url}",
    "autoLogin": true
  }
}
COMPUTOR_EOF
touch "$HOME/workspace/.computor"

if [ -x "$HOME/personalize" ]; then
  "$HOME/personalize" >/tmp/personalize.log 2>&1 || true
fi

# Machine-level settings are scoped to this code-server instance. The official
# extension uses this installation for language services, execution and debug.
#
# MATLAB.defaultEditor is off because it cannot succeed here. The extension
# tries to make VS Code MATLAB's default editor by looking for a `code`
# executable — `which code`, then the paths a desktop install would use — and a
# browser-based editor has none, so every workspace greeted its owner with
# "Unable to set MATLAB default editor to Visual Studio Code" and an extension
# host error. Nothing in this container can satisfy the check; `edit foo.m` at
# the MATLAB prompt has never opened a tab here and does not now.
#
# Workspace trust is off because the prompt it puts in front of a new workspace
# has only one honest answer and a costly wrong one. Until it is answered the
# editor is in Restricted Mode, which disables the Computor extension outright:
# no course tree, no Figures panel, no sign-in. The folder being asked about is
# ~/workspace in a single-tenant container the student owns, opened for them by
# the workspace itself, so the question buys nothing and a student who dismisses
# it is left with an editor that looks broken.
USER_DATA_DIR="/home/coder/.local/share/code-server-${workspace_name_lower}"
SETTINGS_FILE="$USER_DATA_DIR/User/settings.json"
mkdir -p "$USER_DATA_DIR/User"
if [ ! -f "$SETTINGS_FILE" ]; then
  cat > "$SETTINGS_FILE" <<'SETTINGS_EOF'
{
  "MATLAB.installPath": "/opt/matlab/R2024b",
  "MATLAB.signIn": true,
  "MATLAB.defaultEditor": false,
  "security.workspace.trust.enabled": false
}
SETTINGS_EOF
else
  # Workspaces built before a setting was added already have this file, and it
  # is written once and then owned by the student — so add what is missing and
  # touch nothing else. A file with comments in it (VS Code allows them) is not
  # parseable here; leaving it alone is the right answer either way.
  python3 - "$SETTINGS_FILE" <<'MERGE_EOF' || echo "WARN: could not update $SETTINGS_FILE; its settings stay as they are" >&2
import json
import os
import sys
import tempfile

path = sys.argv[1]
wanted = {
    "MATLAB.installPath": "/opt/matlab/R2024b",
    "MATLAB.signIn": True,
    "MATLAB.defaultEditor": False,
    "security.workspace.trust.enabled": False,
}

try:
    with open(path, encoding="utf-8") as handle:
        settings = json.load(handle)
except ValueError as error:
    # VS Code accepts comments and trailing commas in settings.json; json does
    # not. A file this cannot read is a file it has no business rewriting.
    raise SystemExit("settings.json is not plain JSON (%s)" % error)
if not isinstance(settings, dict):
    raise SystemExit("settings.json does not hold an object")

missing = {key: value for key, value in wanted.items() if key not in settings}
if not missing:
    raise SystemExit(0)

settings.update(missing)
with tempfile.NamedTemporaryFile(
    "w", encoding="utf-8", dir=os.path.dirname(path), delete=False
) as out:
    json.dump(settings, out, indent=2)
    out.write("\n")
    temporary = out.name
os.replace(temporary, path)
print("settings.json: added " + ", ".join(sorted(missing)))
MERGE_EOF
fi

# code-server compares its session cookie against HASHED_PASSWORD, so handing it
# the argon2 hash of the per-user app secret lets the ingress inject a
# ready-made session — the user never sees a login page, while a request that
# did not come through the ingress (another workspace dialling this container
# directly on the shared bridge) has no cookie and is bounced to the login page.
%{ if app_hash != "" }
# SINGLE quotes: an argon2 hash is $argon2id$v=19$m=...$salt$digest, and in
# double quotes the shell expands every $-segment as an undefined variable —
# code-server then sees a mangled value, never matches the injected cookie, and
# shows its login page.
export HASHED_PASSWORD='${app_hash}'
CODE_SERVER_AUTH=password
%{ else }
echo "WARNING: no workspace app secret was issued — the editor is reachable" \
     "by any other workspace on this network." >&2
CODE_SERVER_AUTH=none
%{ endif }

code-server \
  --auth "$CODE_SERVER_AUTH" \
  --bind-addr 0.0.0.0:${code_server_port} \
  --abs-proxy-base-path "${coder_base_path}/${owner_name}/${workspace_name}" \
  --extensions-dir /opt/code-server/extensions \
  --user-data-dir "$USER_DATA_DIR" \
  /home/coder/workspace \
  >/tmp/code-server.log 2>&1 &

# Block until code-server actually accepts connections. The agent only reports
# lifecycle_state=ready once this script exits, and the web launch page sends the
# user to the workspace on that signal — without this gate the script would exit
# the instant code-server was *launched* and the user would land on a 502.
# Any HTTP answer proves it is listening, hence no curl -f (code-server 302s to
# its login page under password auth). Capped well under the agent's 300s
# startup_script_timeout; falling through is not fatal.
for _ in $(seq 1 120); do
  curl -s -o /dev/null --max-time 1 "http://127.0.0.1:${code_server_port}/" && break
  sleep 1
done
