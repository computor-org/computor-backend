# Second Docker daemon that runs only Coder workspaces (and their ingress).
# Own socket, data-root, exec-root, pidfile, containerd namespace and
# networks; userns-remap to computor-ws; no iptables management (the
# workspace egress policy owns the firewall for its bridges, see
# computor-infra prod/workspace-egress.sh). See README.md.
[Unit]
Description=Docker daemon for Computor workspaces
After=network-online.target containerd.service computor-ws-homes.service
Wants=network-online.target
Requires=containerd.service computor-ws-homes.service
RequiresMountsFor=/var/lib/docker-ws

[Service]
Type=notify
# Direct I/O on the data-root's loop device: without it the backing file's
# page cache is charged to whichever container writes, and a large write
# OOM-kills it (seen in rehearsal). The mount unit cannot set it.
ExecStartPre=/bin/sh -c 'losetup --direct-io=on "$$(findmnt -n -o SOURCE --mountpoint /var/lib/docker-ws)"'
ExecStart=/usr/bin/dockerd --config-file /etc/docker/daemon-ws.json --containerd=/run/containerd/containerd.sock
# Socket directory survives daemon restarts, so bind mounts of it stay valid.
RuntimeDirectory=computor-ws-docker
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecReload=/bin/kill -s HUP $MAINPID
TimeoutStartSec=0
Restart=always
RestartSec=2
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
KillMode=process
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
