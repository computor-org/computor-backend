# Docker API allowlist for temporal-worker-coder (coder-worker-socket-proxy).
#
# Replaces the haproxy.cfg.template of the pinned tecnativa/docker-socket-proxy
# image (its entrypoint still renders ${BIND_CONFIG}). Upstream filters only by
# path prefix plus one global POST switch; with that, any client allowed
# /containers or /exec is root on the host (privileged container, / mounted),
# and /volumes with POST can create a local volume that bind-mounts any host
# path. So this file enumerates method + path for exactly the calls the worker
# makes (tasks/temporal_coder_setup.py) and refuses everything else:
#
#   GET  /_ping /version                     client handshake
#   POST /build                              image build (classic builder)
#   GET  /images/json, /images/{n}/json      list, inspect
#   POST /images/{n}/tag, /images/{n}/push   tag, push to the local registry
#   DELETE /images/{n}                       untag stale versions
#   GET  /distribution/{n}/json              registry digest
#   GET  /system/df                          volume sizes
#   GET  /volumes, /volumes/{n}              volume inspect
#   DELETE /volumes/coder-(home|scratch)-*   delete a workspace volume
#
# Container create/start/exec, volume create, image pull/load/import, network,
# swarm, plugin, secret and session endpoints are all refused. The worker's
# volume-ownership repair and registry GC run on the host instead
# (ops/coder/hostops).
#
# /build is further restricted: a body other than a tar archive is refused
# (Docker would read form parameters from a urlencoded body, past the query
# checks), and so are the parameters that reach beyond an ordinary bridge
# build: networkmode (host network namespace), cgroupparent, remote (the
# daemon fetching a URL from the host), version / session / outputs (BuildKit,
# whose RUN --network=host entitlement dockerd grants by default).
#
# Image names the worker creates, pushes or removes must lie in its own
# registry, ${CODER_REGISTRY_HOST} (set on this container; it must match the
# worker's CODER_REGISTRY_HOST, and unset nothing matches): the /build t=
# parameter (exactly one), the tag repo= parameter (exactly one), the image
# pushed and the image deleted. Otherwise the worker could retag an image the
# host runs by tag (e.g. a compose service image) or push a host image to an
# outside registry. Tag and push carry no form body (Docker would read repo=
# from a urlencoded body before the query), so only no body type or JSON.
global
    log stdout format raw daemon "${LOG_LEVEL}"
    pidfile /run/haproxy.pid
    maxconn 4000
    server-state-file /var/lib/haproxy/server-state

defaults
    mode http
    log global
    option httplog
    option dontlognull
    option http-server-close
    option redispatch
    retries 3
    timeout http-request 10s
    timeout queue 1m
    timeout connect 10s
    timeout client 10m
    timeout server 10m
    timeout http-keep-alive 10s
    timeout check 10s
    maxconn 3000
    load-server-state-from-file global
    errorfile 400 /usr/local/etc/haproxy/errors/400.http
    errorfile 403 /usr/local/etc/haproxy/errors/403.http
    errorfile 408 /usr/local/etc/haproxy/errors/408.http
    errorfile 500 /usr/local/etc/haproxy/errors/500.http
    errorfile 502 /usr/local/etc/haproxy/errors/502.http
    errorfile 503 /usr/local/etc/haproxy/errors/503.http
    errorfile 504 /usr/local/etc/haproxy/errors/504.http

backend dockerbackend
    server dockersocket $SOCKET_PATH

# Builds and pushes stream for a long time with possibly long silent gaps
# (a cold MATLAB layer). The worker's own activity timeouts bound them.
backend dockerlong
    timeout server 3h
    server dockersocket $SOCKET_PATH

frontend dockerfrontend
    bind ${BIND_CONFIG}
    timeout client 3h

    # No dot segments or encoded slashes: the path checks below must see the
    # path Docker routes.
    http-request deny if { path,url_dec -m sub .. }
    http-request deny if { path -m sub -i %2f }

    acl handshake   path,url_dec -m reg -i ^(/v[0-9.]+)?/(_ping|version)$
    acl build       path,url_dec -m reg -i ^(/v[0-9.]+)?/build$
    acl images_list path,url_dec -m reg -i ^(/v[0-9.]+)?/images/json$
    acl image_json  path,url_dec -m reg -i ^(/v[0-9.]+)?/images/[a-z0-9_./:@-]+/json$
    acl image_tag   path,url_dec -m reg -i ^(/v[0-9.]+)?/images/[a-z0-9_./:@-]+/tag$
    acl image_push  path,url_dec -m reg -i ^(/v[0-9.]+)?/images/[a-z0-9_./:@-]+/push$
    acl image_one   path,url_dec -m reg -i ^(/v[0-9.]+)?/images/[a-z0-9_./:@-]+$
    acl dist_json   path,url_dec -m reg -i ^(/v[0-9.]+)?/distribution/[a-z0-9_./:@-]+/json$
    acl system_df   path,url_dec -m reg -i ^(/v[0-9.]+)?/system/df$
    acl volumes     path,url_dec -m reg -i ^(/v[0-9.]+)?/volumes(/[a-z0-9][a-z0-9_.-]*)?$
    acl ws_volume   path,url_dec -m reg -i ^(/v[0-9.]+)?/volumes/coder-(home|scratch)-[a-z0-9_.-]+$

    acl one_type    req.fhdr_cnt(content-type) eq 1
    acl tar_type    req.fhdr(content-type) -m str -i application/tar application/x-tar
    acl build_param query,url_dec -m reg -i (^|&)(networkmode|cgroupparent|remote|version|session|outputs)=

    # Registry prefix, compared literally (-m beg; a regex would let the dots
    # of a host name match any character).
    acl reg_path    path,url_dec,regsub(^/v[0-9.]+/,/) -m beg "/images/${CODER_REGISTRY_HOST}/"
    acl reg_t       urlp(t),url_dec -m beg "${CODER_REGISTRY_HOST}/"
    acl reg_repo    urlp(repo),url_dec -m beg "${CODER_REGISTRY_HOST}/"
    acl multi_t     query,url_dec -m reg (^|&)t=.*&t=
    acl multi_repo  query,url_dec -m reg (^|&)repo=.*&repo=
    acl no_type     req.fhdr_cnt(content-type) eq 0
    acl json_type   req.fhdr(content-type) -m reg -i ^application/json[[:space:]]*(;.*)?$

    http-request deny if build build_param
    http-request deny if build !reg_t
    http-request deny if build multi_t
    http-request deny if image_tag !reg_repo
    http-request deny if image_tag multi_repo
    http-request deny if image_push !reg_path
    http-request deny if image_one METH_DELETE !reg_path
    http-request deny if image_tag !no_type !one_type
    http-request deny if image_tag !no_type !json_type
    http-request deny if image_push !no_type !one_type
    http-request deny if image_push !no_type !json_type
    http-request deny if build !one_type
    http-request deny if build !tar_type

    http-request allow if handshake METH_GET
    http-request allow if build METH_POST
    http-request allow if images_list METH_GET
    http-request allow if image_json METH_GET
    http-request allow if image_tag METH_POST
    http-request allow if image_push METH_POST
    http-request allow if image_one METH_DELETE
    http-request allow if dist_json METH_GET
    http-request allow if system_df METH_GET
    http-request allow if volumes METH_GET
    http-request allow if ws_volume METH_DELETE
    http-request deny

    use_backend dockerlong if build || image_push
    default_backend dockerbackend
