[
  {
    "alias": "example-oidc",
    "displayName": "Example Institute SSO",
    "enabled": false,
    "providerId": "oidc",
    "discoveryUrl": "https://idp.example.edu/.well-known/openid-configuration",
    "clientId": "computor",
    "clientSecretEnv": "IDP_EXAMPLE_CLIENT_SECRET",
    "defaultScopes": "openid email profile",
    "trustEmail": true,
    "syncMode": "FORCE",
    "mappers": {
      "email": "email",
      "givenName": "given_name",
      "familyName": "family_name",
      "username": "preferred_username"
    }
  },
  {
    "alias": "github",
    "displayName": "GitHub",
    "enabled": false,
    "providerId": "github",
    "clientId": "CHANGE_ME_GITHUB_OAUTH_APP_CLIENT_ID",
    "clientSecretEnv": "IDP_GITHUB_CLIENT_SECRET",
    "defaultScopes": "user:email",
    "trustEmail": false,
    "syncMode": "IMPORT"
  }
]
