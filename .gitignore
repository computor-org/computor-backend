# But keep computor-client generated files (needed for Docker builds)
# Generated TypeScript types/clients in computor-web/src/generated/ are tracked in git

# Brokered external identity providers — real institute config is local-only,
# like .env. Commit only data/keycloak/identity-providers.example.json.
data/keycloak/identity-providers.json

# Bootstrap deployments — real service definitions (with tokens via ${env}) are
# local-only, like .env. Commit only the *.example.yaml templates.
# `**/` (not `*/`) so subdirectories are covered too: the earlier
# `data/deployments/*.yaml` did not match data/deployments/courses/*.yaml, and
# three real course configs reached a public branch before anyone noticed.
data/deployments/**/*.yaml
data/deployments/**/*.yml
!data/deployments/**/*.example.yaml
!data/deployments/**/*.example.yml

# Next.js
computor-web/.next/
# Auto-generated by `next dev`/`next build`; its typed-routes import path flips
# between .next/dev/types and .next/types depending on the last command run.
computor-web/next-env.d.ts
computor-web/tsconfig.tsbuildinfo

# Playwright e2e artifacts
computor-web/test-results/
computor-web/playwright-report/
computor-web/.playwright/

__pycache__
.vscode
tmp/

# Snapshots produced by extract_system.sh: a full pg_dump (password hashes,
# encrypted tokens, personal data) plus mirrored MinIO buckets. This repo is
# public — these must never be committed.
computor_export/
computor_export.tar.gz
computor_export*.tar.gz
**.egg-info/
.prefectignore
**/venv/**
**/.venv/**
start.sh
**/dist/**
**/build/**

**/node_modules/**
/.pnp
.pnp.js

/coverage

/build

.DS_Store

# Environment files (keep templates, ignore actual configs)
.env
.env.common
.env.dev
.env.prod
.env.coder
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.preview
ops/environments/.env.preview
*.env.preview
# Keep templates in version control
!.env.*.template

# Old environment files (for migration period)
.env.dev.old
.env.prod.old
startup.sh.old

# Coder deployment environment
ops/coder/.env

# Runtime pprof debug socket the coder CLI drops in its working directory
.coder/

npm-debug.log*
yarn-debug.log*
yarn-error.log*

/plugins/*
!/plugins/.gitkeep
data/auth_plugins.json

# Playwright artifacts, wherever they land (a run from the repo root writes here)
test-results/
playwright-report/

# Claude Code: agents/skills are shared, personal settings are not.
# settings.local.json accumulates machine-specific permission rules and has
# held credentials before — never commit it.
.claude/settings.local.json
